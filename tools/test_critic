def test_read_descriptions_matches_by_filename(tmp_path):
    (tmp_path / "images").mkdir()
    (tmp_path / "images" / "a.jpg").write_bytes(b"x")
    (tmp_path / "descriptions.csv").write_text(
        'filename,description\na.jpg,"samurai, from behind"\nmissing.jpg,nope\n')
    rows, missing = read_descriptions(tmp_path)
    assert rows == [("a.jpg", "samurai, from behind")]
    assert missing == ["missing.jpg"]


def test_read_descriptions_requires_header(tmp_path):
    (tmp_path / "descriptions.csv").write_text("a.jpg,samurai\n")
    with pytest.raises(ValueError, match="header"):
        read_descriptions(tmp_path)


def test_label_roundtrip(tmp_path):
    item = LabeledItem(filename="a.jpg", description="d", spec=make_spec(),
                       human=[human_verdict("subject", True),
                              human_verdict("camera_angle", False, "front view"),
                              FieldVerdict.skipped("lighting")])
    save_label(tmp_path, item)
    [back] = load_labels(tmp_path)
    assert back == item
    assert set(back.human_by_field()) == {"subject", "camera_angle"}


def test_best_threshold():
    t, acc = best_threshold([0.8, 0.9, 0.6], [0.1, 0.3, 0.2])
    assert 0.3 < t <= 0.6 and acc == 1.0
    assert best_threshold([0.9], []) == (None, None)


def _critic_eval(scores: dict[str, float]) -> Evaluation:
    verdicts = [FieldVerdict(field=f, score=scores.get(f, 0.9), passed=scores.get(f, 0.9) >= 0.5)
                for f in IMAGE_FIELDS]
    verdicts += [FieldVerdict.skipped(f) for f in ShotSpec.video_fields()]
    return Evaluation(verdicts=verdicts, stage=EvaluableIn.IMAGE)


def test_compare_counts_false_pass_and_false_fail():
    items = [
        LabeledItem(filename="a", description="d", spec=make_spec(),
                    human=[human_verdict("camera_angle", False), human_verdict("subject", True)]),
        LabeledItem(filename="b", description="d", spec=make_spec(),
                    human=[human_verdict("camera_angle", True), human_verdict("subject", True)]),
    ]
    evs = {"a": _critic_eval({"camera_angle": 0.8}),      # critic passes a wrong angle
           "b": _critic_eval({"subject": 0.2})}           # critic fails a right subject
    stats, dis = compare(items, evs)
    assert stats["camera_angle"].false_pass == 1 and stats["camera_angle"].agree == 1
    assert stats["subject"].false_fail == 1 and stats["subject"].agree == 1
    assert stats["lighting"].n == 0                       # unlabeled fields don't count
    assert overall_agreement(stats) == 0.5
    assert {(d.filename, d.field) for d in dis} == {("a", "camera_angle"), ("b", "subject")}