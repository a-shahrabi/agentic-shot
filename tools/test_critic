import json
from pathlib import Path

import pytest

from agentic_shot.agents.critic import CachedCritic, VLMCritic
from agentic_shot.backends.llm import parse_structured
from agentic_shot.critic_eval import (
    LabeledItem, best_threshold, compare, human_verdict, load_labels,
    overall_agreement, read_descriptions, save_label,
